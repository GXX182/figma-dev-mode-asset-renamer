{
  "name": "图片命名下载",
  "id": "dev-mode-asset-renamer-local",
  "api": "1.0.0",
  "main": "dist/code.js",
  "ui": "dist/ui.html",
  "build": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File server/start-server.ps1",
  "documentAccess": "dynamic-page",
  "editorType": [
    "dev"
  ],
  "capabilities": [
    "inspect",
    "vscode"
  ],
  "networkAccess": {
    "allowedDomains": [
      "*"
    ],
    "reasoning": "插件需要访问本机 127.0.0.1:7879 转发服务，并兼容用户选择直接访问其 AI 图片分析服务。"
  }
}
